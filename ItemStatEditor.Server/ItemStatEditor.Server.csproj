<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ItemStatEditor — small SPT 4.1.x SERVER mod. Applies the item stat edits
    made in the LevelGate Editor's Item Stats tab (meds, stims, food), kept in
    user\mods\ItemStatEditor\item_stats.json, when the server starts (after
    other mods such as BalancedMeds / Item Property Backport, so these win).

    Build: set SptServerDir to the folder containing user\mods (e.g.
    C:\SPT\SPT_Runtime), then Build; the DLL is copied to
    user\mods\ItemStatEditor\. Needs the .NET 10 SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ItemStatEditor.Server</AssemblyName>
    <RootNamespace>ItemStatEditor.Server</RootNamespace>
    <SptServerDir>C:\SPT\SPT_Runtime</SptServerDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the server at runtime, so compile against them only. -->
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="CopyToServerMods" AfterTargets="Build">
    <MakeDir Directories="$(SptServerDir)\user\mods\ItemStatEditor" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptServerDir)\user\mods\ItemStatEditor\" />
  </Target>

</Project>
