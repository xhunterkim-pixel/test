<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CustomTraders.Editor.exe (Trader Editor) — Windows editor for the
    CustomTraders server mod. The window hosts a web page (ui\) drawn by the
    Edge engine (WebView2, part of Windows 10/11) for a smooth interface; the
    C# side reads/writes user\mods\CustomTraders\traders\<trader>\trader.json.
    Needs the .NET 10 SDK to build (Windows).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CustomTraders.Editor</AssemblyName>
    <RootNamespace>CustomTraders.Editor</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WFO1000: designer-serialization hint; the window is built in code, not the designer. -->
    <NoWarn>$(NoWarn);WFO5001;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TraderModels.cs" Link="Shared\TraderModels.cs" />
    <!-- The interface: copied next to the exe (not packed into it). -->
    <None Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    The WebView2 package also brings its WPF control (Microsoft.Web.WebView2.Wpf), which wants a
    newer WindowsBase and makes the build warn (MSB3277). The editor is WinForms only, so that
    reference is dropped before references are resolved.
  -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
