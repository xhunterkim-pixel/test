<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LevelGate</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LevelGate</RootNamespace>
    <!-- Change this to wherever your SPT client install lives -->
    <SptDir>C:\SPT</SptDir>
  </PropertyGroup>

  <!-- The editor (LevelGate.Editor\) is its own Windows project: keep its files out of the plugin. -->
  <ItemGroup>
    <Compile Remove="LevelGate.Editor\**" />
    <None Remove="LevelGate.Editor\**" />
    <Content Remove="LevelGate.Editor\**" />
    <EmbeddedResource Remove="LevelGate.Editor\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      All of these DLLs must be copied in from YOUR game install — they are
      not redistributable, which is why they aren't included here:
        - BepInEx.dll, BepInEx.Harmony.dll        -> SPT\BepInEx\core\
        - 0Harmony.dll                            -> SPT\BepInEx\core\
        - Assembly-CSharp.dll                     -> SPT\EscapeFromTarkov_Data\Managed\
        - UnityEngine*.dll, Comfort.dll           -> SPT\EscapeFromTarkov_Data\Managed\
        - Newtonsoft.Json.dll                     -> SPT\EscapeFromTarkov_Data\Managed\
      Easiest approach: point ReferencePath at the Managed + BepInEx\core
      folders instead of listing each Reference by hand.
    -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Lock icon overlay: UI Image, and PNG/JPG loading (Texture2D.LoadImage). -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Auto-copy the built DLL + config folder straight into your plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <ItemGroup>
      <ConfigFiles Include="config\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(SptDir)\BepInEx\plugins\LevelGate\config" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptDir)\BepInEx\plugins\LevelGate\" />
    <!-- Only seed the config on first install: SkipUnchangedFiles still copies
         whenever the files differ, which would overwrite the live
         level_requirements.json (edited through F9 / the context menu) with
         this example on every build. -->
    <Copy SourceFiles="@(ConfigFiles)" DestinationFolder="$(SptDir)\BepInEx\plugins\LevelGate\config\"
          Condition="!Exists('$(SptDir)\BepInEx\plugins\LevelGate\config\%(ConfigFiles.Filename)%(ConfigFiles.Extension)')" />
  </Target>

</Project>
