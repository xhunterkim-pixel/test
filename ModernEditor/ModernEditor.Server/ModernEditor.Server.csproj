<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ModernEditor.dll — the SPT 4.1.x server mod of Modern Editor (one DLL). At server start it reads
    user\mods\ModernEditor\traders\<folder>\trader.json (custom traders, offers / barters, quests),
    applies user\mods\ModernEditor\item_stats.json (meds, stims, food edits) and moves quests whose level
    follows an item to that item's Level Gate level. Replaces the CustomTraders and ItemStatEditor mods.

    Build: set SptServerDir to the folder containing user\mods (e.g. C:\SPT\SPT_Runtime), then Build;
    the DLL is copied to user\mods\ModernEditor\. Needs the .NET 10 SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ModernEditor</AssemblyName>
    <RootNamespace>ModernEditor.Server</RootNamespace>
    <SptServerDir>C:\SPT\SPT_Runtime</SptServerDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TraderModels.cs" Link="Shared\TraderModels.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplied by the running server; compile-only. -->
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="CopyToServerMods" AfterTargets="Build">
    <MakeDir Directories="$(SptServerDir)\user\mods\ModernEditor" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptServerDir)\user\mods\ModernEditor\" />
  </Target>

</Project>
